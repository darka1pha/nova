{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "dist",
    "rootDir": ".",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "declaration": true,
    "sourceMap": true,
    "paths": {
      "@nova/core": ["./packages/core/src/index.ts"],
      "@nova/core/*": ["./packages/core/src/*"]
    }
  },
  "include": ["src/**/*.ts", "packages/core/src/**/*.ts"]
}

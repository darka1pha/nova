# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Enterprise Next App

# --- Database (used when Prisma is enabled) ---
DATABASE_URL="postgresql://user:password@localhost:5432/app_db?schema=public"

# --- Authentication ---
AUTH_SECRET=replace-with-a-strong-random-string
AUTH_ACCESS_TOKEN_TTL=900
AUTH_REFRESH_TOKEN_TTL=2592000

# --- Better Auth (used when enabled) ---
BETTER_AUTH_SECRET=replace-with-a-strong-random-string
BETTER_AUTH_URL=http://localhost:3000

# --- External APIs ---
API_BASE_URL=https://api.example.com
API_TIMEOUT_MS=10000

# --- Analytics (optional) ---
NEXT_PUBLIC_ANALYTICS_ID=

# --- Sentry (used when enabled) ---
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.1
NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0.1
SENTRY_ORG=
SENTRY_PROJECT=
